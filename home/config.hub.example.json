{
  "enabled": false,
  "public_url": "https://home.example.com",
  "database": "/var/lib/character-home/hub.db",
  "port": 8765,
  "trust_loopback_proxy": true,
  "clients": {
    "scaramouche": "REPLACE_WITH_RANDOM_SCARAMOUCHE_SECRET",
    "wanderer": "REPLACE_WITH_RANDOM_WANDERER_SECRET"
  },
  "agents": {"main": "REPLACE_WITH_RANDOM_RELAY_SECRET"},
  "admins": [123456789],
  "devices": {
    "bedroom_lamp": {
      "type": "hue", "agent": "main", "enabled": false, "mode": "MANUAL",
      "actions": ["power", "brightness", "color", "color_temperature", "scene", "test"],
      "users": [123456789], "bots": ["scaramouche", "wanderer"], "guilds": [0],
      "timezone": "America/Los_Angeles", "hours": [8, 22], "cooldown_seconds": 300,
      "max_changes_hour": 6, "min_brightness": 10, "max_brightness": 70,
      "colors": {"purple": {"x": 0.25, "y": 0.15}},
      "scenes": {"calm": "00000000-0000-0000-0000-000000000001"}
    },
    "decorative_sign": {
      "type": "kasa", "agent": "main", "enabled": false, "mode": "MANUAL",
      "category": "NEVER_AUTOMATE", "actions": ["power", "test"],
      "users": [123456789], "bots": ["scaramouche", "wanderer"], "guilds": [0],
      "timezone": "America/Los_Angeles", "hours": [8, 22], "cooldown_seconds": 300
    },
    "bedroom_clock": {
      "type": "cast", "agent": "main", "enabled": false, "mode": "MANUAL",
      "actions": ["play", "pause", "stop", "volume", "test"],
      "users": [123456789], "bots": ["scaramouche", "wanderer"], "guilds": [0],
      "timezone": "America/Los_Angeles", "hours": [8, 22], "cooldown_seconds": 300,
      "min_volume": 0.1, "max_volume": 0.5, "allow_roommate": false,
      "allow_alarm": false, "allow_alarm_quiet": false, "assets": []
    },
    "office_printer": {
      "type": "printer", "agent": "main", "enabled": false, "mode": "CONFIRM",
      "actions": ["print_note", "test"],
      "users": [123456789], "bots": ["scaramouche", "wanderer"], "guilds": [0],
      "timezone": "America/Los_Angeles", "hours": [8, 22], "cooldown_seconds": 600,
      "document_types": ["text/plain"], "max_pages_per_job": 1, "max_jobs_day": 3
    }
  },
  "owntracks": {
    "my_phone": {
      "enabled": false, "user_id": 123456789, "username": "phone",
      "password": "REPLACE_WITH_RANDOM_OWNTRACKS_SECRET",
      "bots": ["scaramouche", "wanderer"], "debounce_seconds": 300,
      "max_accuracy_m": 200,
      "zones": {"HOME": {"latitude": 0.0, "longitude": 0.0, "radius_meters": 100}}
    }
  }
}
